{
  "name": "docket",
  "version": "2.5.0",
  "private": true,
  "description": "Docket — a daily work log with jobs. Installable offline web app (PWA) that also runs as a single, double-click HTML file.",
  "keywords": [
    "work log",
    "timesheet",
    "pwa",
    "offline",
    "jobs"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stefs-Time/Track.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prestart": "node scripts/build.js",
    "start": "node server.js",
    "dev": "node scripts/dev.js",
    "test": "npm run build && playwright test",
    "check": "npm run lint && node --check src/app.js && node --check src/sw.js",
    "screenshots": "node scripts/screenshots.js",
    "icons": "node scripts/icons.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "eslint": "9.39.5",
    "globals": "15.15.0"
  }
}
