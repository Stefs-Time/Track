{
  "id": "./",
  "name": "Docket — Daily Work Log",
  "short_name": "Docket",
  "description": "Log the work you do each day, group it by job, and copy it straight into an email, timesheet or invoice. Works offline; your data stays on your device.",
  "start_url": "./",
