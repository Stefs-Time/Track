# Optional local settings. Copy this file to .env and change what you need:
# the server reads .env on start if it exists. Variables already set in the
# environment (Railway sets PORT for you) take priority over this file.
# There are no secrets to configure.

# Port the server listens on.
PORT=3000
# Interface to bind; 0.0.0.0 makes it reachable inside a container.
HOST=0.0.0.0
